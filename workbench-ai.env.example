# 复制到 /etc/workbench/ai.env 后填写真实值，并执行 chmod 600。
# OpenAI 兼容服务填 openai；Duiapi 这类 Anthropic Messages 兼容服务填 anthropic。
# Duiapi: AI_API_PROTOCOL=anthropic, AI_API_BASE=https://www.duiapi.com/v1
AI_API_PROTOCOL=openai
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=replace_with_your_server_side_key
AI_MODEL=deepseek-v4-flash
