[Unit]
Description=竞品作战台 Competitive Workbench
Documentation=file:/opt/workbench/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workbench
Group=workbench
WorkingDirectory=/opt/workbench
ExecStart=/usr/bin/node /opt/workbench/server.js

Environment=NODE_ENV=production
Environment=PORT=8090
Environment=DATA_DIR=/var/lib/workbench
# PaddleOCR/PaddleX 默认把模型与临时文件写进 $HOME；服务用户没有 home，
# 因此显式复用可写、持久化的数据目录。
Environment=HOME=/var/lib/workbench
Environment=TZ=Asia/Shanghai
# 详情长图：跟 install.sh 装 Chromium 时用的路径必须一致，否则 Playwright
# 会在服务启动时又去下一次浏览器（服务用户没有出网权限来源/权限也不该有）。
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/workbench/browser-cache
# 只在第一次启动、还没有 users.json 时用来创建管理员
Environment=ADMIN_USER=admin
Environment=ADMIN_PIN=123456
Environment=SESSION_DAYS=30
# 可选的 OpenAI Chat Completions 兼容服务配置。该文件只应由 root 读取，
# 不进入代码仓库；未配置时 AI 新闻生成功能会明确提示缺少配置。
EnvironmentFile=-/etc/workbench/ai.env

Restart=always
RestartSec=3

# 崩了自动拉起，但如果 60 秒内连崩 5 次就停下来，别把日志刷爆
StartLimitBurst=5
StartLimitIntervalSec=60

# 安全加固：这个进程只需要读代码、写数据目录，别的什么都不给
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workbench
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workbench

[Install]
WantedBy=multi-user.target
